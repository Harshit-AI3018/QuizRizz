# Base URL for API requests. In development with Vite proxy, leave empty or use /api/v1
VITE_API_BASE_URL=/api/v1

# Target backend for Vite proxy
VITE_BACKEND_TARGET=http://127.0.0.1:8000
VITE_BACKEND_WS_TARGET=ws://127.0.0.1:8000

# Optional explicit WebSocket base URL for production (e.g. wss://campusquiz-backend.onrender.com)
# When omitted, automatically derived from VITE_API_BASE_URL or current origin
# VITE_WS_BASE_URL=wss://campusquiz-backend.onrender.com
