# CampusQuiz staging database connection.
# Use the direct (unpooled) PostgreSQL endpoint and restricted campusquiz_app role.
DATABASE_URL=postgresql://campusquiz_app:replace-with-database-password@ep-sample.neon.tech/campusquiz_staging?sslmode=require

# Configure a random secret before implementing HMAC ticket issuance.
AUTH_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
