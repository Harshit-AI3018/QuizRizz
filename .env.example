# CampusQuiz Staging Database Connection
# Neon Serverless PostgreSQL 15+ Connection String format:
# postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/campusquiz_staging?sslmode=require

# Application HMAC Signing Secret (Definer / Backend service)
AUTH_HMAC_SECRET=campusquiz_backend_internal_hmac_secret_key_2026

